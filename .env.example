# Copy to .env and fill in. NEVER commit or share .env (anyone with it can send email as you and read your database).

# ── Local development ──────────────────────────────────────────────
DJANGO_DEBUG=1
SITE_URL=http://127.0.0.1:8000
# Using an ngrok tunnel locally? Add its host here, and its https URL to CSRF_TRUSTED_ORIGINS:
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-name.ngrok-free.dev
# CSRF_TRUSTED_ORIGINS=https://your-name.ngrok-free.dev

# ── Production (leave DJANGO_DEBUG out or 0) ───────────────────────
# DJANGO_SECRET_KEY=            python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# DJANGO_ALLOWED_HOSTS=agronga.com,www.agronga.com
# SITE_URL=https://agronga.com
# PAYSTACK_SECRET_KEY=sk_live_...
# BREVO_API_KEY=
# DB_NAME=agronga
# DB_USER=agronga
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# REDIS_URL=redis://127.0.0.1:6379/1
# CLIENT_IP_HEADER=CF-Connecting-IP       # or X-Forwarded-For behind nginx (see core/net.py)
# ADMIN_EMAIL=you@agronga.com             # receives server-error emails
# PAYSTACK_WEBHOOK_IPS=                   # optional: comma-separated, copy from Paystack's webhook docs

# ── Optional ───────────────────────────────────────────────────────
# FX_FALLBACK_NGN_PER_USD=1500
# FX_AUTO_REFRESH=1
# CONTENT_CACHE_SECONDS=600
# QUOTE_INBOX=info@agronga.com
# DEFAULT_FROM_EMAIL=info@agronga.com
# LOG_LEVEL=INFO
